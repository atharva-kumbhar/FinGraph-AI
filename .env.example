# FinGraph AI Environment Configuration Example
# Copy this file to .env and fill in your actual API keys and credentials.

# Server Configuration
FINGRAPH_HOST=0.0.0.0
PORT=8000
FINGRAPH_CORS_ORIGINS=*

# Dataset & Pipeline Configuration
FINGRAPH_DATASET_PATH=data/sp100/chunks.jsonl
FINGRAPH_TOTAL_CHUNKS=50487
FINGRAPH_TOTAL_TOKENS=15000000
FINGRAPH_PRICE_PER_1K_TOKENS=0.0008
FINGRAPH_REQUEST_TIMEOUT_SECONDS=8
FINGRAPH_NVIDIA_TIMEOUT_SECONDS=120

# Retrieval & Provider Settings
FINGRAPH_RETRIEVAL_TOP_K=50
FINGRAPH_RAG_RETRIEVAL_TOP_K=25
FINGRAPH_GRAPH_RETRIEVAL_TOP_K=10
FINGRAPH_GRAPH_CHUNK_LIMIT=2
FINGRAPH_RETRIEVAL_BACKEND=keyword
FINGRAPH_LLM_ONLY_PROVIDER=nvidia
FINGRAPH_RAG_PROVIDER=nvidia
FINGRAPH_GRAPHRAG_PROVIDER=nvidia

# NVIDIA API Credentials
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
FINGRAPH_LLM_MODEL=meta/llama-3.3-70b-instruct

# Gemini API Credentials (Optional / Alternative Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=models/gemini-2.5-flash

# Hugging Face Token (Optional for LLM Judge)
HF_TOKEN=your_hf_token_here
HF_JUDGE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# TigerGraph Cloud Database Credentials
TG_HOST=https://your-tigergraph-instance.tgcloud.io
TG_GRAPH_NAME=database1
TG_USERNAME=your_tigergraph_username
TG_PASSWORD=your_tigergraph_password
TG_SECRET=your_tigergraph_secret
TG_API_TOKEN=your_tigergraph_api_token
TG_VERTEX_TYPE=Company
TG_EDGE_TYPE=FILED_BY
TG_RELATIONSHIP_EDGE_TYPE=FILED_BY
TG_MENTIONED_EDGE_TYPE=MENTIONS_EXECUTIVE
TG_CHUNK_VERTEX_TYPE=Document
TG_CHUNK_ENTITY_LIMIT=2
TG_CHUNK_FETCH_LIMIT=3
TG_VERIFY_SSL=false
TG_UPLOADED_VERTICES=4872
TG_UPLOADED_EDGES=5678
TG_VERTEX_LIMIT=500
TG_MAX_EDGES=12

